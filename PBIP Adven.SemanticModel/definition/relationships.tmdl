	fromColumn: salesorderheader.CustomerID
	toColumn: customer.CustomerID

relationship salesorderheader_SalesPersonID_to_salesperson
	fromColumn: salesorderheader.SalesPersonID
	toColumn: salesperson.BusinessEntityID

relationship salesorderheader_TerritoryID_to_salesterritory
